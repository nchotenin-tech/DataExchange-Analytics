# =============================================================================
# ตั้งค่า AI สำหรับแท็บ "ถาม-ตอบ"
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น  ai.yaml  (วางไว้ข้าง DentalDX.exe / app.py)
#          แล้วใส่ api_key ของตัวเอง
#
# ai.yaml ถูกกันไว้ใน .gitignore แล้ว — กุญแจจะไม่ถูก commit ขึ้น GitHub
# ถ้าไม่มีไฟล์นี้ โปรแกรมยังทำงานได้ปกติ (ใช้ตัวแปลคำถามแบบคีย์เวิร์ด)
# =============================================================================

# anthropic | openai | gemini | ollama | off
provider: anthropic

# anthropic : claude-sonnet-4-5 / claude-haiku-4-5  (haiku ถูกและเร็วพอสำหรับงานนี้)
# openai    : gpt-4o-mini
# gemini    : gemini-2.5-flash   << อ่าน "คำเตือน free tier" ข้างล่างก่อนใช้
#
# ชื่อโมเดลข้างบนเป็นแค่ตัวอย่าง ผู้ให้บริการปลดระวางโมเดลเก่าเรื่อย ๆ
# ถ้าใช้แล้วขึ้น HTTP 404 แปลว่าโมเดลนั้นไม่มีแล้ว — เปิดหน้าเว็บ กด ⚙ ตั้งค่า AI
# แล้วกดปุ่ม ↻ ข้างช่องโมเดล โปรแกรมจะไปถามว่ากุญแจของคุณใช้โมเดลอะไรได้บ้าง
# ollama    : llama3.1  (รันในเครื่อง ไม่ต้องมี api_key ไม่ต้องต่อเน็ต)
model: claude-haiku-4-5

# ---------------------------------------------------------------------------
# คำเตือน: Gemini free tier
#   Google ระบุในเงื่อนไขว่า prompt และคำตอบของ "บริการที่ไม่เสียเงิน"
#   อาจถูกนำไปใช้พัฒนาผลิตภัณฑ์ และอาจมีคนเข้ามาอ่าน (human review)
#   Google เองแนะนำว่าอย่าส่งข้อมูลที่เป็นความลับหรือข้อมูลส่วนบุคคล
#
#   DentalDX ไม่ส่งข้อมูลเด็กรายคนอยู่แล้ว แต่ตัวเลขสรุประดับอำเภอถือเป็น
#   ข้อมูลของหน่วยงาน -> ถ้าจะใช้ Gemini ควรผูกบัญชีเป็น paid tier
#   หรือไม่ก็ตั้ง phrase: false (ตัวเลขจะไม่ถูกส่งขึ้น cloud เลย)
# ---------------------------------------------------------------------------

# ใส่กุญแจตรงนี้ หรือจะตั้งเป็น environment variable DENTALDX_AI_KEY ก็ได้
api_key: ""

# ใช้เมื่อผ่าน proxy ของหน่วยงาน หรือใช้ ollama ที่เครื่องอื่น
# base_url: "http://10.0.0.5:11434"

timeout: 60

# true  = โชว์ข้อมูลที่กำลังจะส่งออกให้ตรวจก่อน แล้วรอกดยืนยันทุกครั้ง (แนะนำ)
# false = ส่งทันทีโดยไม่ถาม (ใช้เมื่อคุ้นแล้วและมั่นใจในปลายทาง)
confirm: true

# true  = ให้ AI เรียบเรียงคำตอบเป็นประโยค (ส่งตัวเลขสรุปขึ้น cloud ด้วย)
# false = ตอบเป็นรูปแบบมาตรฐานที่โปรแกรมสร้างเอง
#         >> เรียก AI ครั้งเดียว ประหยัดครึ่งหนึ่ง และ **ตัวเลขไม่ออกจากเครื่องเลย**
#            สิ่งที่ส่งขึ้น cloud เหลือแค่คำถาม + ชื่อตาราง/ตัวชี้วัด
phrase: true
